# =============================================================================
# Secrets - TEMPLATE ONLY - Do NOT commit real values
# =============================================================================
# Apply manually or use Sealed Secrets / External Secrets Operator:
#   kubectl apply -f k8s/secrets.yaml
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: adk-secrets
  namespace: adk-platform
type: Opaque
stringData:
  GOOGLE_API_KEY: "REPLACE_ME"
  GITLAB_TOKEN: "REPLACE_ME"
  GITLAB_API_URL: "https://gitlab.com"
---
apiVersion: v1
kind: Secret
metadata:
  name: adk-kubeconfig
  namespace: adk-platform
type: Opaque
stringData:
  kubeconfig.yml: |
    REPLACE_WITH_KUBECONFIG_CONTENT
