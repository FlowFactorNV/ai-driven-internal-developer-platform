# ============================================================
# Kubernetes Agent - Standalone A2A microservice
# ============================================================
FROM python:3.14-slim AS builder

WORKDIR /build

# Install Node.js (required for npx-based Kubernetes MCP server)
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl ca-certificates && \
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Pre-install the Kubernetes MCP server globally to avoid npx download at runtime
RUN npm install -g kubernetes-mcp-server@latest

# Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# ============================================================
FROM python:3.14-slim

WORKDIR /app

# Install Node.js runtime and MCP servers globally
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl ca-certificates && \
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    npm install -g kubernetes-mcp-server@latest && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Copy Python packages from builder
COPY --from=builder /usr/local/lib/python3.14/site-packages /usr/local/lib/python3.14/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy agent code - only the kubernetes_agent directory
COPY kubernetes_agent/ ./kubernetes_agent/

# Create non-root user
RUN groupadd -r adk && useradd -r -g adk -u 1000 -d /app -s /bin/bash adk && \
    mkdir -p /app/.npm && \
    chown -R adk:adk /app

USER 1000

# kubeconfig will be mounted from a Kubernetes Secret
ENV KUBECONFIG=/app/secrets/kubeconfig.yml

EXPOSE 8000

# Serve via adk api_server with A2A enabled
CMD ["adk", "api_server", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--no-reload", \
     "--a2a", \
     "/app"]
